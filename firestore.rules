
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Allow read access to everyone for articles, likes, and comments
    match /articles/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /likes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.user_id;
    }
    
    match /comments/{commentId} {
      allow read: if true;
      // Allow users to create their own comments
      allow create: if request.auth != null && request.auth.uid == request.resource.data.user_id;
      // Allow users to update their own comments
      allow update: if request.auth != null && request.auth.uid == resource.data.user_id;
      // Allow users to delete their own comments OR admins to delete any comment
      allow delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isAdmin());
    }
    
    match /appointments/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Updated rules for contact_messages to ensure proper permissions
    match /contact_messages/{messageId} {
      // Allow anyone to create contact messages without authentication
      allow create: if true;
      
      // Allow any authenticated user to read contact messages
      allow read: if request.auth != null;
      
      // Allow any authenticated user to update or delete messages
      allow update, delete: if request.auth != null;
    }
    
    // Rules for edited_texts collection
    match /edited_texts/{textId} {
      // Anyone can read the edited texts
      allow read: if true;
      
      // Allow any authenticated user to write to edited_texts
      allow write: if request.auth != null;
    }
  }
}
